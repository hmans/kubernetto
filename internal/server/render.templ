package server

import (
	"fmt"

	"kubernetto/internal/kube"
)

templ Page(state PageState) {
	<!doctype html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Kubernetto</title>
			<script src="/assets/app.js"></script>
			<link rel="stylesheet" href="/assets/app.css"/>
			<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@1.0.0/bundles/datastar.js"></script>
		</head>
		<body>
			<div id="page-progress" class="page-progress" aria-hidden="true" { progressAttrs()... }></div>
			<div class="app" { appSignalAttrs(state)... }>
				<aside class="side">
					<div class="brand">
						<div class="brand-mark">K</div>
						<div>Kubernetto</div>
					</div>
					<div class="context">
						if state.Cluster != nil {
							<label for="context">Context</label>
							<select id="context" { contextSelectAttrs()... }>
								for _, cluster := range state.Clusters {
									<option value={ cluster.ContextName } selected?={ state.Signals.Context == cluster.ContextName }>{ cluster.ContextName }</option>
								}
							</select>
							if state.Cluster.ClusterName != "" {
								<span>{ state.Cluster.ClusterName }</span>
							}
							<span>{ state.Cluster.ConfigSource }</span>
						} else {
							<span>Context</span>
							<strong>unconfigured</strong>
							<span>kubeconfig unavailable</span>
						}
					</div>
					@ResourceNavView(state)
				</aside>
				<main class="main">
					<div class="topbar">
						<h1>Cluster Dashboard</h1>
						<div class="topbar-actions">
							<div class="updated">Live summary every 5s</div>
							<div class="theme-switcher" role="group" aria-label="Theme">
								<button type="button" data-theme-option="auto" aria-pressed="true">Auto</button>
								<button type="button" data-theme-option="light" aria-pressed="false">Light</button>
								<button type="button" data-theme-option="dark" aria-pressed="false">Dark</button>
							</div>
						</div>
					</div>
					@SummaryView(state)
					<section class="toolbar" aria-label="Table controls">
						@NamespacePickerView(state)
						<div class="field">
							<label for="query">Search</label>
							<input id="query" type="search" placeholder="Filter visible fields" { searchInputAttrs()... }/>
						</div>
						<button class="icon-button" type="button" title="Refresh" { refreshButtonAttrs()... }>↻</button>
					</section>
					<div class="content-grid">
						@TableView(state)
						@DetailView(state)
					</div>
				</main>
			</div>
		</body>
	</html>
}

templ SummaryView(state PageState) {
	<section id="summary" class="summary" aria-label="Cluster summary">
		if state.Summary.Error != "" {
			<div class="notice danger summary-notice">{ state.Summary.Error }</div>
		}
		<div class="metric">
			<div class="label">Version</div>
			<div class="value">
				if state.Summary.ServerVersion != "" {
					{ state.Summary.ServerVersion }
				} else {
					unknown
				}
			</div>
		</div>
		<div class="metric">
			<div class="label">Nodes</div>
			<div class="value">{ fmt.Sprint(state.Summary.Nodes) }</div>
		</div>
		<div class="metric">
			<div class="label">Pods</div>
			<div class="value">{ fmt.Sprint(state.Summary.Pods) }</div>
		</div>
		<div class="metric">
			<div class="label">Deployments</div>
			<div class="value">{ fmt.Sprint(state.Summary.Deployments) }</div>
		</div>
	</section>
}

templ ResourceNavView(state PageState) {
	<nav id="resource-nav" class="nav" aria-label="Resources">
		for _, resource := range state.Resources {
			<button
				type="button"
				aria-pressed={ checked(state.Signals.Resource, string(resource.Kind)) }
				{ resourceButtonAttrs(resource)... }
			>
				<span>{ resource.Label }</span>
			</button>
		}
	</nav>
}

templ NamespacePickerView(state PageState) {
	<div id="namespace-picker" class="field">
		<label for="namespace">Namespace</label>
		<select
			id="namespace"
			disabled?={ !state.Table.Namespaced }
			{ namespaceSelectAttrs()... }
		>
			<option value="">All namespaces</option>
			for _, namespace := range state.Namespaces {
				<option value={ namespace } selected?={ state.Signals.Namespace == namespace }>{ namespace }</option>
			}
		</select>
		if state.NamespaceErr != "" {
			<span class="updated">{ state.NamespaceErr }</span>
		}
	</div>
}

templ TableView(state PageState) {
	<section id="table-panel" class="table-panel" aria-live="polite">
		<div class="table-head">
			<h2>{ state.Table.Label }</h2>
			<div class="updated">{ fmt.Sprintf("%d rows · updated %s", len(state.Table.Rows), formatClock(state.Table.UpdatedAt)) }</div>
		</div>
		if state.Table.Error != "" {
			<div class="notice danger">{ state.Table.Error }</div>
		} else if len(state.Table.Rows) == 0 {
			<div class="empty">No { lower(state.Table.Label) } found.</div>
		} else {
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							for _, column := range state.Table.Columns {
								<th scope="col" aria-sort={ sortAria(column, state.Table.SortColumn, state.Table.SortOrder) }>
									<button
										type="button"
										class={ sortButtonClass(column, state.Table.SortColumn) }
										{ sortHeaderAttrs(column)... }
									>
										<span>{ column }</span>
										<span class="sort-indicator" aria-hidden="true">{ sortIndicator(column, state.Table.SortColumn, state.Table.SortOrder) }</span>
									</button>
								</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, row := range state.Table.Rows {
							<tr { rowAttrs(row, state)... }>
								for _, cell := range row.Cells {
									<td class={ cell.Class }>
										if hasClass(cell.Class, "status") {
											<span>{ cell.Value }</span>
										} else {
											{ cell.Value }
										}
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</section>
}

templ DetailView(state PageState) {
	<aside id="detail-panel" class="detail-panel" aria-live="polite">
		if state.Detail.Name == "" {
			<div class="detail-empty">
				<h2>Details</h2>
				<p>Select a row to inspect labels, status, ownership, and resource-specific fields.</p>
			</div>
		} else {
			<div class="detail-head">
				<div class="detail-title">
					<span>{ state.Detail.Label }</span>
					<h2>{ state.Detail.Name }</h2>
					if state.Detail.Namespace != "" {
						<div class="updated">{ state.Detail.Namespace }</div>
					}
				</div>
				<button class="icon-button" { closeDetailAttrs()... }>×</button>
			</div>
			if state.Detail.Error != "" {
				<div class="notice danger">{ state.Detail.Error }</div>
			} else {
				<div class="detail-tabs" role="tablist" aria-label="Detail views">
					<button { detailTabAttrs("overview", state)... }>Overview</button>
					<button { detailTabAttrs("events", state)... }>Events</button>
					<button { detailTabAttrs("yaml", state)... }>YAML</button>
				</div>
				if state.Signals.DetailMode == "events" {
					@DetailEventsView(state.Detail.Events)
				} else if state.Signals.DetailMode == "yaml" {
					@DetailYAMLView(state.Detail.YAML)
				} else {
					@DetailOverviewView(state)
				}
			}
		}
	</aside>
}

templ DetailOverviewView(state PageState) {
	<div class="detail-status">
		<span class={ "status-pill " + state.Detail.StatusKey }>{ state.Detail.Status }</span>
		if state.Detail.Age != "" {
			<span>{ state.Detail.Age }</span>
		}
	</div>
	<dl class="detail-list">
		if state.Detail.CreatedAt.IsZero() == false {
			<div>
				<dt>Created</dt>
				<dd>{ formatTimestamp(state.Detail.CreatedAt) }</dd>
			</div>
		}
		if state.Detail.UID != "" {
			<div>
				<dt>UID</dt>
				<dd>{ state.Detail.UID }</dd>
			</div>
		}
		for _, field := range state.Detail.Fields {
			<div>
				<dt>{ field.Name }</dt>
				<dd>{ field.Value }</dd>
			</div>
		}
	</dl>
	for _, section := range state.Detail.Sections {
		@DetailSectionView(section)
	}
	if len(state.Detail.Labels) > 0 {
		@DetailSectionView(kube.DetailSection{Title: "Labels", Fields: state.Detail.Labels})
	}
	if len(state.Detail.Annotations) > 0 {
		@DetailSectionView(kube.DetailSection{Title: "Annotations", Fields: state.Detail.Annotations})
	}
}

templ DetailEventsView(events []kube.ResourceEvent) {
	if len(events) == 0 {
		<div class="detail-empty">
			<h2>Events</h2>
			<p>No recent events are cached for this resource.</p>
		</div>
	} else {
		<div class="event-list">
			for _, event := range events {
				<article class={ "event-item " + lower(event.Type) }>
					<div class="event-head">
						<span>{ event.Reason }</span>
						<span>{ event.Age }</span>
					</div>
					<p>{ event.Message }</p>
					<div class="event-meta">
						<span>{ event.Type }</span>
						if event.Count > 1 {
							<span>{ fmt.Sprintf("%d times", event.Count) }</span>
						}
						if event.LastSeen.IsZero() == false {
							<span>{ formatTimestamp(event.LastSeen) }</span>
						}
					</div>
				</article>
			}
		</div>
	}
}

templ DetailYAMLView(value string) {
	if value == "" {
		<div class="detail-empty">
			<h2>YAML</h2>
			<p>YAML is unavailable for this resource.</p>
		</div>
	} else {
		<pre class="yaml-view"><code>{ value }</code></pre>
	}
}

templ DetailSectionView(section kube.DetailSection) {
	<section class="detail-section">
		<h3>{ section.Title }</h3>
		<dl class="detail-list compact">
			for _, field := range section.Fields {
				<div>
					<dt>{ field.Name }</dt>
					<dd>{ field.Value }</dd>
				</div>
			}
		</dl>
	</section>
}
